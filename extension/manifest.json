{
  "manifest_version": 3,
  "name": "쿠팡 광고계산기",
  "version": "0.24.0",
  "description": "쿠팡 판매자센터·광고센터 화면의 어제 데이터를 저장하고 캠페인별 순이익 장부를 보여줍니다. 설치 외에 아무것도 필요 없습니다.",
  "permissions": [
    "storage",
    "scripting",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "webNavigation",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "https://*.coupang.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "쿠팡 광고계산기 수집기"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.coupang.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "app.html#data",
    "open_in_tab": true
  }
}